				{"Introduce"[m, n, e, f, h1, h2, h3],
					"Cases"["booleanCases"["lessEqual"[e, f]]],
					(* e <= f: f is e + k, and n 2^f is (n 2^k) 2^e *)
					"Introduce"[t], "Cases"["lessEqualWitness"[e, f, "lessEqualTrue"[e, f, t]]], "Introduce"[k, w],
					"Rewrite"[w, "At" -> h3], "Rewrite"[w],
					"Rewrite"["powerAddition"[2, e, k], "At" -> h3], "Rewrite"["powerAddition"[2, e, k]],
