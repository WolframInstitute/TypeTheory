					"Have"[s, m 2^e + 2^e <= (n 2^k) 2^e], "Exact"["naturalStrictScaling"[m, n 2^k, 2^e, "powerOfTwoPositive"[e], g]],
					"LinearArithmetic",
					(* f < e: e is f + 1 + k, and m 2^e is at least 2^53 2^f, past n 2^f *)
					"Introduce"[t], "Have"[l, f + 1 <= e], "Exact"["naturalLessOfNotLessEqual"[f][e]["lessEqualFalse"[e, f, t]]],
					"Cases"["lessEqualWitness"[f + 1, e, l]], "Introduce"[k, w],
					"Rewrite"[w, "At" -> h3],
					"Rewrite"["powerAddition"[2, f + 1, k], "At" -> h3],
					"Have"[d, 2^(f + 1) == 2^f 2], "Reflexivity",
					"Rewrite"[d, "At" -> h3],
					"Have"[r1, 1 <= 2^f], "Exact"["powerOfTwoPositive"[f]],
					"Have"[k1, 1 <= 2^k], "Exact"["powerOfTwoPositive"[k]],
					"Have"[p1, low 2^f <= m 2^f], "Exact"["naturalLessEqualScaling"[low, m, 2^f, h1]],
					"Have"[p2, 1 (m 2^f) <= 2^k (m 2^f)], "Exact"["naturalLessEqualScaling"[1, 2^k, m 2^f, k1]],
					"Have"[p3, n 2^f <= high 2^f], "Exact"["naturalLessEqualScaling"[n, high, 2^f, h2]],
					"Have"[contradiction, Typed[False, TypeUniverse[0]]], "LinearArithmetic",
