(* ::Package:: *)

(*
The second slice of the machine reals: the spacing of the machine reals, the certificate of the rounding and the
standard model, as theorems over "MachineReals" that rest on the axiom "real64ResultNearest" and nothing else new.
	"real64ResultOfNearestQ"         "real64NearestQ"[q, m, a, b] == "true" gives the machine real r with
	                                 "real64Result"[q] == "left"[r] and r 2^b == m 2^a: a value the Wolfram Language
	                                 computed enters a proof once the kernel has computed its check
	"real64StandardModel"            for |q| < 2^1024 - 2^970 the result r of q: in the normal range, 2^-1022 <= |q|,
	                                 r == q (1 + d) with 2^53 |d| <= 1; in the subnormal range |r - q| <= 2^-1075, both
	                                 written in the scale 2^1074
	"real64PlusStandardModel"        the same of "real64Plus"[x, y], the rounding of x + y
	"real64TimesStandardModel"       the same of every real that "real64Times"[x, y] gives: it leaves where the
	                                 product rounds to a subnormal real
The proofs work in the scale 2^1074, where every machine real is a whole number z 2^f with |z| < 2^53. A machine real
in the form of the largest significand, 2^52 <= n < 2^53, has its neighbours a step 2^e away, or 2^(e - 1) below a
power of two; the check's bounds put the real it names as near q as the axiom's nearest, with the tie rule's parity,
so the two are the same ("abstractCertificate"). The standard model takes no floor of q: it anchors on the nearest
real, puts it in its canonical form ("canonicalGrid", by induction on natural numbers) and compares q with the
neighbour on its side ("nearestRelative", "nearestSubnormal"). docs/notes/MachineReals.md has the plan and its record.
*)


(* ::Section:: *)
(*PackageExported*)




(* ::Section:: *)
(*PackageScoped*)


PackageScoped[$machineRealSpacingDeclarations]


(* ::Section:: *)
(*Usage Messages*)


$machineRealSpacingDeclarations::usage = "$machineRealSpacingDeclarations is the list of the theorems of the second slice of the machine reals, in order: the spacing, the certificate \"real64ResultOfNearestQ\" and the standard model \"real64StandardModel\", each proved in the environment of the reals so far."


(* ::Section:: *)
(*Function Definitions*)


(* the theorems in order; a With of several gives its bounds as numbers, which the arithmetic tactics take as
   coefficients where a power of 2 would be an atom *)
$machineRealSpacingDeclarations = {
	(* the naturals' strict order, a strict inequality scaled by a positive factor, and the grid above
	   a machine real in the form of the largest m, scaled to integers *)
	(* a + 1 <= b where b <= a fails: by induction on a, b cased *)
	(* a p < b p with p positive gives a p + p <= b p: b <= a would give b p <= a p *)
	machineTheorem["naturalStrictScaling",
		ForAll[{Typed[a, NonNegativeIntegers], Typed[b, NonNegativeIntegers], Typed[p, NonNegativeIntegers]}, Implies[1 <= p, Implies[a p + 1 <= b p, a p + p <= b p]]],
		{"Introduce"[a, b, p, h1, h2], "Cases"["booleanCases"["lessEqual"[b, a]]],
			"Introduce"[t], "Have"[l, b <= a], "Exact"["lessEqualTrue"[b, a, t]], "NonlinearArithmetic",
			"Introduce"[t], "Have"[l, a + 1 <= b], "Exact"["naturalLessOfNotLessEqual"[a][b]["lessEqualFalse"[b, a, t]]], "NonlinearArithmetic"}],
	(* a <= b scaled by any natural p *)
	machineTheorem["naturalLessEqualScaling",
		ForAll[{Typed[a, NonNegativeIntegers], Typed[b, NonNegativeIntegers], Typed[p, NonNegativeIntegers]}, Implies[a <= b, a p <= b p]],
		{"Introduce"[a, b, p, h], "Have"[z, 0 <= p], "LinearArithmetic", "NonlinearArithmetic"}],
