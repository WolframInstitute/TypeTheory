					"Rewrite"["powerAddition"[2, e + 1, k], "At" -> h3], "Rewrite"["powerAddition"[2, e + 1, k]],
					"Have"[g, (n 2^k) 2^(e + 1) + 1 <= low 2^(e + 1)], "LinearArithmetic",
					"Have"[s, (n 2^k) 2^(e + 1) + 2^(e + 1) <= low 2^(e + 1)], "Exact"["naturalStrictScaling"[n 2^k, low, 2^(e + 1), "powerOfTwoPositive"[e + 1], g]],
					"Have"[ee, e <= e + 1], "LinearArithmetic",
					"Have"[u, 2^e <= 2^(e + 1)], "Exact"["powerOfTwoMonotone"[e, e + 1, ee]],
					"LinearArithmetic",
					(* f <= e: e is f + k, and 2^52 2^(e + 1) - 2^e is (2^53 - 1) 2^e, at least (2^53 - 1) 2^f, at least n 2^f *)
					"Introduce"[t], "Have"[l, f + 1 <= e + 1], "Exact"["naturalLessOfNotLessEqual"[f][e + 1]["lessEqualFalse"[e + 1, f, t]]],
					"Have"[l2, f <= e], "LinearArithmetic",
					"Cases"["lessEqualWitness"[f, e, l2]], "Introduce"[k, w],
					"Rewrite"[w],
					"Have"[d, 2^((f + k) + 1) == 2^(f + k) 2], "Reflexivity", "Rewrite"[d],
					"Rewrite"["powerAddition"[2, f, k]],
					"Have"[k1, 1 <= 2^k], "Exact"["powerOfTwoPositive"[k]],
					"Have"[q2, 1 2^f <= 2^k 2^f], "Exact"["naturalLessEqualScaling"[1, 2^k, 2^f, k1]],
					"Have"[q3, n 2^f <= high 2^f], "Exact"["naturalLessEqualScaling"[n, high, 2^f, h2]],
