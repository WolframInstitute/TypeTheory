(* ::Package:: *)

(*
Final composition (rung 7) of Smith's chain of emulations to Wolfram's (2,3) Turing machine:
finite-form Conjecture 0 ("conjecture0Finite") and the full universality theorem ("wolfram23Universal")
for arbitrary binary-tape Turing machines, with computable configuration decoder "decodeTM".
Built on Wolfram23.wl, Wolfram23System5.wl, Wolfram23System4.wl, and Wolfram23System3.wl.
The design is in docs/notes/Wolfram23Universality.md.

	"strictMonoOfSucc",             schedule lifting ("forwardSimulationSchedule") turning a
	"monoOfSucc",                   forward simulation into a strictly increasing time schedule
	"forwardSimulationSchedule"     along a finite run
	"configSize",                   confinement of Wolfram's (2,3) machine ("turingMachineConfinement"):
	"lookaheadStep0Props",          as long as lookaheadStep[system0] succeeds and the state is not C,
	"turingMachineConfinement"      turingMachineStep[system0] agrees step for step and preserves tape size
	"maxNat", "maxList",            initial System 5 bound construction ("bound5Of", "bound5Self",
	"maxLists", "bound5Of",         "bound5Steps") and fueled-step lifters for cyclic tag, System 5,
	"fueledCyclicTagSteps",         and System 4
	"fueledSystem5Steps",
	"fueledSystem4Steps"
	"c0Start", "conjecture0Finite"  Smith's finite-form Conjecture 0: any finite cyclic tag run ending
	                                in nonempty data is emulated by Wolfram's (2,3) machine from a
	                                state-A configuration, decoding to doubleWord[ci.data] at each step
	                                and exiting cleanly to the right
	"undbl", "decodeOneHot",        computable decoders undoing doubling, Cook's one-hot tag encoding,
	"decodeTagWord", "parseWord",   Minsky's symbol words, and base-2 tape numbers ("natToBits",
	"divMod2", "natToBits",         "trimTrailingFalse", "canon", "decodeCTS", "decodeTM"), with
	"trimTrailingFalse", "canon",   exact round-trip theorems
	"decodeCTS", "decodeTM"
	"wolfram23Universal"            headline universality theorem: for every finite run of any binary
	                                Turing machine, Wolfram's (2,3) machine emulates every step with
	                                decodeTM recovering canon[ci], stays confined, and exits cleanly
*)


(* ::Section:: *)
(*PackageExported*)




(* ::Section:: *)
(*PackageScoped*)


PackageScoped[$universalityDeclarations]


