			"Have"[hGe1, 1 <= Length[Map["minskyEncode", "binaryWord"["binaryConfiguration"[q, left, head, right]]]]],
			"Change"[1 <= Length[Prepend["minskyEncode"["symbolA"[q]]][Map["minskyEncode", Prepend["pad"][Join["pairs"["symbolAlpha"[q], "pad", "tapeValue"[left]], Prepend["symbolB"[q]][Prepend["pad"]["pairs"["symbolBeta"[q], "pad", 2 * "tapeValue"[right] + "bitValue"[head]]]]]]]]] ],
			"Change"[1 <= Length[Map["minskyEncode", Prepend["pad"][Join["pairs"["symbolAlpha"[q], "pad", "tapeValue"[left]], Prepend["symbolB"[q]][Prepend["pad"]["pairs"["symbolBeta"[q], "pad", 2 * "tapeValue"[right] + "bitValue"[head]]]]]]]] + 1],
			"LinearArithmetic",
			"Have"[f0, Typed[False, TypeUniverse[0]]], "LinearArithmetic", "Exact"[f0]
		}
	],

	(* =================================================================== *)
	(* Part F: T8 — Headline Universality Theorem (wolfram23Universal)     *)
	(* =================================================================== *)
	machineTheorem["wolfram23Universal",
		ForAll[{Typed[tm, NonNegativeIntegers -> Booleans -> "MachineTransition"], Typed[S, NonNegativeIntegers],
				Typed[c, "BinaryConfiguration"], Typed[n, NonNegativeIntegers], Typed[c2, "BinaryConfiguration"]},
			Implies["machineBelow"[tm, S],
				Implies[c[["state"]] + 1 <= S,
					Implies["steps"["binaryStep"[tm], n, c] == "some"[c2],
						Exists[{Typed[start, "LookaheadConfiguration"], Typed[w, NonNegativeIntegers], Typed[b, NonNegativeIntegers],
								Typed[times, NonNegativeIntegers -> NonNegativeIntegers], Typed[T, NonNegativeIntegers]},
							And[start[["state"]] == "stateA",
								And[ForAll[{Typed[i, NonNegativeIntegers]}, Implies[i + 1 <= n, times[i] + 1 <= times[i + 1]]],
									And[ForAll[{Typed[i, NonNegativeIntegers]}, Implies[i <= n,
											And[times[i] <= T,
												Exists[{Typed[ci, "BinaryConfiguration"], Typed[cfgi, "LookaheadConfiguration"]},
													And["steps"["binaryStep"[tm], i, c] == "some"[ci],
														And["steps"["turingMachineStep"["system0"], times[i], start] == "some"[cfgi],
															And["decodeTM"[S, "pow2"[w], b, cfgi] == "some"["canon"[ci]],
																"colorOccurs"["color0", cfgi[["right"]]]]]]]]]],
										And[ForAll[{Typed[tau, NonNegativeIntegers]}, Implies[tau <= T,
												Exists[{Typed[cfgTau, "LookaheadConfiguration"]},
													And["steps"["turingMachineStep"["system0"], tau, start] == "some"[cfgTau],
														And["configSize"[cfgTau] == "configSize"[start], Not[cfgTau[["state"]] == "stateC"]]]]]],
											Exists[{Typed[L, {"Color"}]},
												And["steps"["turingMachineStep"["system0"], T + 1, start] == "some"["lookaheadConfiguration"[L, "color0", Typed[{}, {"Color"}], "stateA"]],
													Length[L] == "configSize"[start]]]]]]]]]]]],
		{
			"Introduce"[tm, S, c, n, c2, hMach, hSt, hRunTm],
			(* Step 1: Schedule tt from machineToCyclicTag *)
			"Have"[hRel0, Exists[{Typed[v, {NonNegativeIntegers}]},
				And[Exists[{Typed[w, {"MinskySymbol"}]}, And[w == "binaryWord"[c], v == Map["minskyEncode", w]]],
					And["cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], Map["minskyEncode", "binaryWord"[c]]] == "cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], v],
						"allBelow"[84 * S + 1, v]]]]],
			"Exact"["existsIntroduction"[Map["minskyEncode", "binaryWord"[c]],
				"andIntroduction"["existsIntroduction"["binaryWord"[c],
					"andIntroduction"["equalityReflexivity"["binaryWord"[c]], "equalityReflexivity"[Map["minskyEncode", "binaryWord"[c]]]]],
					"andIntroduction"["equalityReflexivity"["cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], Map["minskyEncode", "binaryWord"[c]]]],
						"mapEncodeBelow"[S, "binaryWord"[c], "statesBelowBinaryWord"[S, c, hSt]]]]]],
			"Cases"["forwardSimulationSchedule"["BinaryConfiguration", "CyclicTagConfiguration", "binaryStep"[tm], "cyclicTagStep",
				Function[{Typed[bc, "BinaryConfiguration"], Typed[x, "CyclicTagConfiguration"]},
					Exists[{Typed[v, {NonNegativeIntegers}]}, And[Exists[{Typed[w, {"MinskySymbol"}]}, And[w == "binaryWord"[bc], v == Map["minskyEncode", w]]],
						And[x == "cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], v], "allBelow"[84 * S + 1, v]]]]],
				"machineToCyclicTag"[tm, S, hMach], n, c,
				"cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], Map["minskyEncode", "binaryWord"[c]]], c2, hRel0, hRunTm]],
			"Introduce"[tt, htt1], "Cases"[htt1], "Introduce"[htt0, htt2], "Cases"[htt2], "Introduce"[httMono, httTrace],
			(* Extract final CTS state at M = tt[n] *)
			"Cases"[httTrace[n, "lessEqualReflexivity"]], "Introduce"[cn, hn1], "Cases"[hn1], "Introduce"[ctsN, hn2],
			"Cases"[hn2], "Introduce"[eqCn, hn3], "Cases"[hn3], "Introduce"[hRunCtsN, hRelN],
			"Cases"[hRelN], "Introduce"[vn, hvn1], "Cases"[hvn1], "Introduce"[exWn, hvn2],
			"Cases"[exWn], "Introduce"[wn, hwn], "Cases"[hwn], "Introduce"[eqWn, eqVn],
			"Cases"[hvn2], "Introduce"[eqCtsN, hBelN],
			"Have"[hDataNNe, Not[ctsN[["data"]] == Typed[{}, {Booleans}]]],
			"Rewrite"[eqCtsN], "Rewrite"[eqVn], "Rewrite"[eqWn],
			"Exact"["encodeWordBinaryNonEmpty"[S, cn]],
			(* Step 2: Apply conjecture0Finite at M = tt[n]! *)
			"Cases"["conjecture0Finite"["cookConfiguration"[84 * S + 1, "minskyNumbers"[tm], Map["minskyEncode", "binaryWord"[c]]], tt[n], ctsN, hRunCtsN, hDataNNe]],
			"Introduce"[start, hc1], "Cases"[hc1], "Introduce"[w, hc2], "Cases"[hc2], "Introduce"[b, hc3],
			"Cases"[hc3], "Introduce"[timesCts, hc4], "Cases"[hc4], "Introduce"[T, hc5],
			"Cases"[hc5], "Introduce"[hStartA, hc6], "Cases"[hc6], "Introduce"[hMonoCts, hc7],
			"Cases"[hc7], "Introduce"[hTraceCts, hc8], "Cases"[hc8], "Introduce"[hConf, hExit],
			(* Compose schedule: times[i] = timesCts[tt[i]] *)
			"Have"[hMonoAll, ForAll[{Typed[i, NonNegativeIntegers]}, Implies[i + 1 <= n, timesCts[tt[i]] + 1 <= timesCts[tt[i + 1]]]]],
			"Introduce"[i, hi],
			"Have"[hTtLt, tt[i] + 1 <= tt[i + 1]], "Exact"[httMono[i, hi]],
			"Have"[hTtLe, tt[i + 1] <= tt[n]], "Exact"["monoOfSucc"[tt, n, httMono, i + 1, n, hi, "lessEqualReflexivity"]],
			"Exact"["strictMonoOfSucc"[timesCts, tt[n], hMonoCts, tt[i + 1], tt[i], hTtLt, hTtLe]],
			"Have"[hTraceAll, ForAll[{Typed[i, NonNegativeIntegers]}, Implies[i <= n,
				And[timesCts[tt[i]] <= T,
					Exists[{Typed[ci, "BinaryConfiguration"], Typed[cfgi, "LookaheadConfiguration"]},
						And["steps"["binaryStep"[tm], i, c] == "some"[ci],
							And["steps"["turingMachineStep"["system0"], timesCts[tt[i]], start] == "some"[cfgi],
								And["decodeTM"[S, "pow2"[w], b, cfgi] == "some"["canon"[ci]],
									"colorOccurs"["color0", cfgi[["right"]]]]]]]]]]],
			"Introduce"[i, hi],
			"Have"[hTtLeN, tt[i] <= tt[n]], "Exact"["monoOfSucc"[tt, n, httMono, i, n, hi, "lessEqualReflexivity"]],
			"Cases"[httTrace[i, hi]], "Introduce"[ci, hi1], "Cases"[hi1], "Introduce"[ctsi, hi2],
			"Cases"[hi2], "Introduce"[eqCi, hi3], "Cases"[hi3], "Introduce"[hRunCtsi, hReli],
			"Cases"[hReli], "Introduce"[vi, hvi1], "Cases"[hvi1], "Introduce"[exWi, hvi2],
			"Cases"[exWi], "Introduce"[wi, hwi], "Cases"[hwi], "Introduce"[eqWi, eqVi],
			"Cases"[hvi2], "Introduce"[eqCtsi, hBeli],
			"Cases"[hTraceCts[tt[i], hTtLeN]], "Introduce"[hTiLeT, hExCts],
			"Cases"[hExCts], "Introduce"[ctsi2, hci1], "Cases"[hci1], "Introduce"[cfgi, hci2],
			"Cases"[hci2], "Introduce"[eqCtsi2, hci3], "Cases"[hci3], "Introduce"[hRunTmI, hci4],
			"Cases"[hci4], "Introduce"[hDecW23, hOccI],
			"Have"[eqCtsEq, ctsi2 == ctsi],
			"Exact"["someInjective"["CyclicTagConfiguration", ctsi2, ctsi, "equalityTransitivity"["equalitySymmetry"[eqCtsi2], hRunCtsi]]],
			"Have"[hBelEnc, "allBelow"[84 * S + 1, Map["minskyEncode", "binaryWord"[ci]]]],
			"Rewrite"["equalitySymmetry"[eqWi]], "Rewrite"["equalitySymmetry"[eqVi]], "Exact"[hBeli],
			"Have"[hDecTmI, "decodeTM"[S, "pow2"[w], b, cfgi] == "some"["canon"[ci]]],
			"Change"["optionBind"["decodeW23"["pow2"[w], b, cfgi], Function[{Typed[dw, {Booleans}]}, "optionBind"["undbl"[dw], "decodeCTS"[S]]]] == "some"["canon"[ci]]],
			"Rewrite"[hDecW23],
			"Change"["optionBind"["undbl"["doubleWord"[ctsi2[["data"]]]], "decodeCTS"[S]] == "some"["canon"[ci]]],
			"Rewrite"["undblDoubleWord"[ctsi2[["data"]]]],
			"Change"["decodeCTS"[S, ctsi2[["data"]]] == "some"["canon"[ci]]],
			"Rewrite"[eqCtsEq], "Rewrite"[eqCtsi], "Rewrite"[eqVi], "Rewrite"[eqWi],
			"Exact"["decodeCTSWord"[S, ci, hBelEnc]],
			"Exact"["andIntroduction"[hTiLeT, "existsIntroduction"[ci, "existsIntroduction"[cfgi,
				"andIntroduction"[eqCi, "andIntroduction"[hRunTmI, "andIntroduction"[hDecTmI, hOccI]]]]]]],
			"Exact"["existsIntroduction"[start, "existsIntroduction"[w, "existsIntroduction"[b,
				"existsIntroduction"[Function[{Typed[i, NonNegativeIntegers]}, timesCts[tt[i]]],
					"existsIntroduction"[T, "andIntroduction"[hStartA, "andIntroduction"[hMonoAll,
						"andIntroduction"[hTraceAll, "andIntroduction"[hConf, hExit]]]]]]]]]]
		}
	]
}
