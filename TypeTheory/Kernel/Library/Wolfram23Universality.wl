				"parseWord"["minskyWord"[q, "tapeValue"[left], 2 * "tapeValue"[right] + "bitValue"[head]]]] ==
				"some"["binaryConfiguration"[q, "trimTrailingFalse"[left], head, "trimTrailingFalse"[right]]]],
			"Rewrite"["parseWordMinskyWord"[q, "tapeValue"[left], 2 * "tapeValue"[right] + "bitValue"[head]]],
			"Change"["some"["binaryConfiguration"[q, "natToBits"["tapeValue"[left]],
				"divMod2"[2 * "tapeValue"[right] + "bitValue"[head]][["remainderBit"]],
				"natToBits"["divMod2"[2 * "tapeValue"[right] + "bitValue"[head]][["quotient2"]]]]] ==
				"some"["binaryConfiguration"[q, "trimTrailingFalse"[left], head, "trimTrailingFalse"[right]]]],
			"Rewrite"["divMod2Double"["tapeValue"[right], head]],
			"Change"["some"["binaryConfiguration"[q, "natToBits"["tapeValue"[left]], head, "natToBits"["tapeValue"[right]]]] ==
				"some"["binaryConfiguration"[q, "trimTrailingFalse"[left], head, "trimTrailingFalse"[right]]]],
