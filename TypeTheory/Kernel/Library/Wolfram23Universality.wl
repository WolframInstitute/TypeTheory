	TypeTheoryDefinition["decodeTM", Typed[
		Function[{Typed[S, NonNegativeIntegers], Typed[N, NonNegativeIntegers], Typed[b, NonNegativeIntegers], Typed[cfg, "LookaheadConfiguration"]},
			"optionBind"["decodeW23"[N, b, cfg],
				Function[{Typed[dw, {Booleans}]},
					"optionBind"["undbl"[dw], "decodeCTS"[S]]]]],
		NonNegativeIntegers -> NonNegativeIntegers -> NonNegativeIntegers -> "LookaheadConfiguration" -> Option["BinaryConfiguration"]
	]],
	machineTheorem["mapMinskyDecodeEncode",
		ForAll[{Typed[w, {"MinskySymbol"}]}, Map["minskyDecode", Map["minskyEncode", w]] == w],
		{
			"Introduce"[w], "Induction"[w], "Reflexivity",
			"Introduce"[s, rest, ih],
			"Change"[Prepend["minskyDecode"["minskyEncode"[s]]][Map["minskyDecode", Map["minskyEncode", rest]]] == Prepend[s][rest]],
			"Rewrite"["minskyDecodeEncode"[s]], "Rewrite"[ih]
		}
	],
	machineTheorem["decodeCTSWord",
		ForAll[{Typed[S, NonNegativeIntegers], Typed[c, "BinaryConfiguration"]},
			Implies["allBelow"[84 * S + 1, Map["minskyEncode", "binaryWord"[c]]],
				"decodeCTS"[S, "encodeWord"[84 * S + 1, Map["minskyEncode", "binaryWord"[c]]]] == "some"["canon"[c]]]],
		{
			"Introduce"[S, c, hBel],
			"Have"[hPosK, 1 <= 84 * S + 1], "LinearArithmetic",
			"Change"["optionBind"["decodeTagWord"[84 * S + 1, "encodeWord"[84 * S + 1, Map["minskyEncode", "binaryWord"[c]]]],
				Function[{Typed[v, {NonNegativeIntegers}]},
					"optionMap"[Function[{Typed[p, "MinskyParsed"]}, "cfgOfNums"[p[["state"]], p[["leftNum"]], p[["rightNum"]]]],
						"parseWord"[Map["minskyDecode", v]]]]] == "some"["canon"[c]]],
			"Rewrite"["decodeTagWordEncodeWord"[84 * S + 1, Map["minskyEncode", "binaryWord"[c]], hPosK, hBel]],
			"Change"["optionMap"[Function[{Typed[p, "MinskyParsed"]}, "cfgOfNums"[p[["state"]], p[["leftNum"]], p[["rightNum"]]]],
				"parseWord"[Map["minskyDecode", Map["minskyEncode", "binaryWord"[c]]]]] == "some"["canon"[c]]],
			"Rewrite"["mapMinskyDecodeEncode"["binaryWord"[c]]],
			"Cases"[c], "Introduce"[q, left, head, right, hBel],
