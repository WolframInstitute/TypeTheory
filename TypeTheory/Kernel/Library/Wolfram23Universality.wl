	machineTheorem["encodeWordBinaryNonEmpty",
		ForAll[{Typed[S, NonNegativeIntegers], Typed[c, "BinaryConfiguration"]},
			Not["encodeWord"[84 * S + 1, Map["minskyEncode", "binaryWord"[c]]] == Typed[{}, {Booleans}]]],
		{
