	(* =================================================================== *)
	(* Part E: Initial state bound, non-empty CTS word, and T8!            *)
	(* =================================================================== *)
	machineTheorem["statesBelowBinaryWord",
		ForAll[{Typed[S, NonNegativeIntegers], Typed[c, "BinaryConfiguration"]},
			Implies[c[["state"]] + 1 <= S, "statesBelow"[S, "binaryWord"[c]]]],
		{
			"Introduce"[S, c], "Cases"[c], "Introduce"[q, left, head, right, hq],
			"Exact"["andIntroduction"[hq, "andIntroduction"["trueIntroduction",
				"statesBelowJoin"[S, "pairs"["symbolAlpha"[q], "pad", "tapeValue"[left]],
					Prepend["symbolB"[q]][Prepend["pad"]["pairs"["symbolBeta"[q], "pad", 2 * "tapeValue"[right] + "bitValue"[head]]]],
					"statesBelowPairs"[S, "symbolAlpha"[q], "pad", "tapeValue"[left], hq, "trueIntroduction"],
					"andIntroduction"[hq, "andIntroduction"["trueIntroduction",
						"statesBelowPairs"[S, "symbolBeta"[q], "pad", 2 * "tapeValue"[right] + "bitValue"[head], hq, "trueIntroduction"]]]]]]]
		}
